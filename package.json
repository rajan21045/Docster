{
  "name": "docster",
  "displayName": "Docster",
  "description": "Adds doc comments, flags undocumented functions, and generates documentation for JavaScript, TypeScript, Python, Dart, Java, C, C++, C#, Go and PHP.",
  "icon": "icon.png",
  "version": "0.1.1",
  "publisher": "RajanPoudel",
  "license": "MIT",
  "homepage": "https://github.com/rajan21045/Docster#readme",
  "bugs": {
    "url": "https://github.com/rajan21045/Docster/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rajan21045/Docster.git"
  },
  "keywords": [
    "documentation",
    "comments",
    "docstring",
    "jsdoc",
    "javadoc",
    "dart",
    "flutter",
    "python",
    "java",
    "csharp",
    "go",
    "php"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:javascriptreact",
    "onLanguage:typescriptreact",
    "onLanguage:dart",
    "onLanguage:python",
    "onLanguage:java",
    "onLanguage:c",
    "onLanguage:cpp",
    "onLanguage:csharp",
    "onLanguage:go",
    "onLanguage:php"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "docster.addComment",
        "title": "Add Doc Comment",
        "category": "Docster"
      },
      {
        "command": "docster.generateDocs",
        "title": "Generate Documentation",
        "category": "Docster"
      },
      {
        "command": "docster.generateProjectDocs",
        "title": "Generate Project Documentation",
        "category": "Docster"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "docster.addComment",
          "when": "editorLangId =~ /^(javascript|typescript|javascriptreact|typescriptreact|dart|python|java|c|cpp|csharp|go|php)$/",
          "group": "1_modification@99"
        }
      ]
    },
    "configuration": {
      "title": "Docster",
      "properties": {
        "docster.pythonDocstringStyle": {
          "type": "string",
          "enum": [
            "google",
            "numpy"
          ],
          "default": "google",
          "description": "Docstring style used when generating Python documentation."
        },
        "docster.warnMissingComments": {
          "type": "boolean",
          "default": true,
          "description": "Show a warning on functions that have no doc comment."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}