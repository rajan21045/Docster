{
  "name": "DocForge",
  "displayName": "DocForge",
  "description": "Adds doc comments, flags undocumented functions, and generates documentation for JavaScript, TypeScript, Dart and Python.",
  "icon": "icon.png",
  "version": "0.0.1",
  "publisher": "RajanPoudel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rajan21045/auto-doc.git"
  },
  "keywords": [
    "documentation",
    "comments",
    "docstring",
    "jsdoc",
    "dart",
    "python"
  ],
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:dart",
    "onLanguage:python"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "autoDoc.addComment",
        "title": "Add Doc Comment"
      },
      {
        "command": "autoDoc.generateDocs",
        "title": "Generate Documentation"
      },
      {
        "command": "autoDoc.generateProjectDocs",
        "title": "Generate Project Documentation"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.140.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}